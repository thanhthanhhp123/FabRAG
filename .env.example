# Postgres (used by both docker-compose and the ingestion worker)
POSTGRES_USER=fabrag
POSTGRES_PASSWORD=fabrag
POSTGRES_DB=fabrag
DATABASE_URL=postgresql+psycopg://fabrag:fabrag@localhost:5432/fabrag

# Embedding model — pinned here because changing it requires a full re-index
# of every chunk (see CLAUDE.md section 7).
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL=BAAI/bge-reranker-base
GENERATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Chunking (fixed-size baseline — see CLAUDE.md section 6)
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# API security. Replace the development placeholder with a long random secret.
FABRAG_API_KEY=change-me-local-only
FABRAG_RATE_LIMIT_REQUESTS=30
FABRAG_RATE_LIMIT_WINDOW_SECONDS=60
